# Opwise Backend Environment Configuration Example
# Local-First Execution (₹0 Budget)

ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./opwise.sqlite3
DB_ECHO=false
DB_SYNCHRONOUS=NORMAL

# Solver Defaults (Single worker for deterministic reproducibility)
DEFAULT_MAX_TIME_SECONDS=15.0
MAX_ALLOWED_TIME_SECONDS=60.0
SOLVER_NUM_WORKERS=1
DEFAULT_RANDOM_SEED=42

# Domain Limits
MAX_HORIZON_MINUTES=10000000
MAX_OPERATIONS_PER_ORDER=100
MAX_ORDERS_PER_WORKSPACE=1000
