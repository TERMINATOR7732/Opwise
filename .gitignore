# Opwise — Strict Git Ignore Policy
# Governed by PROJECT_RULES.md (Rule 5) and DECISIONS.md (ADR-012)

# Python Virtual Environments & Packages
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
*.egg

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node.js & Frontend Build Outputs
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Persistence (Strictly Decoupled from Git Backup)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
backups/

# Environment Configuration & Local Secrets
.env
.env.local
.env.*.local
*.local

# OS Metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo

.vercel
.env*
